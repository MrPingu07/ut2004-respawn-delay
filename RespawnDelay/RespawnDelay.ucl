Mutator=(ClassName=RespawnDelay.RespawnDelay,IconMaterialName=MutatorArt.nosym,FriendlyName=RespawnDelay.RespawnDelay.FriendlyName,Description=RespawnDelay.RespawnDelay.Description,FallbackName="Respawn Delay",FallbackDesc="Forces players to wait before respawning. Team games scale the delay with allies alive (1->3s, 5->8s, 10->15s) locked at death; solo games use a fixed 3s. While waiting you are a spectator (FIRE to cycle views).")
