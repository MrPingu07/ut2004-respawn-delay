[Public]
Object=(Name=RespawnDelay.RespawnDelay,Class=Class,MetaClass=Engine.Mutator,Description="Respawn Delay,Players must wait before respawning. Team games: global configurable wave cycle (Standard 5s: waits 5-10s, presets from 3s to 30s in the Mutator GUI). Solo games: the same selectable cycle length as a plain wait. While waiting you spectate (FIRE cycles views).")
Mutator=(ClassName=RespawnDelay.RespawnDelay,IconMaterialName=MutatorArt.nosym,FriendlyName=RespawnDelay.RespawnDelay.FriendlyName,Description=RespawnDelay.RespawnDelay.Description,FallbackName="Respawn Delay",FallbackDesc="Forces players to wait before respawning. Team games respawn together in waves on a global configurable cycle (Standard 5s: waits 5-10s, presets 3s-30s); solo games use the same selectable cycle length. While waiting you are a spectator (FIRE to cycle views).")

[RespawnDelay.RespawnDelay]
FriendlyName="Respawn Delay"
Description="Forces players to wait before respawning. Team games respawn together in waves on a global configurable cycle: waits always span one to two cycles (Standard 5s: 5-10s; presets 3s-30s selectable in the Mutator GUI). Solo games use the same selectable cycle length as a plain wait. While waiting you are a spectator (FIRE to cycle views)."

; -- localized strings used by the mutator (via ClientMessage) --
MsgRespawnTeam="Spawn with the next reinforcement wave in %1 seconds"
MsgRespawnSolo="Respawn delay locked at %1 seconds"
MsgSpectateHint="Waiting to respawn - FIRE: next player view, ALT-FIRE: own camera"
MsgStatusWaiting="RespawnDelay: you respawn in %1 seconds"
MsgStatusIdle="RespawnDelay: not waiting to respawn."

; -- mutator GUI (PlayInfo / "Configure" pages) --
RespGroup="Respawn Delay"
CycleDisplayText="Respawn wave cycle"
CycleDescText="Arena [3s]: continuous chaos, near-instant respawns and fast micro-batches (3-6s wait), great for Team Deathmatch and small maps. | Standard [5s]: competitive balance, the perfect equilibrium (5-10s wait), tailored for tactical flow and squad spawning in Onslaught and Assault. | Methodic [10s]: methodical pacing, moderate punishment for dying (10-20s wait), teams regroup into waves before pushing. | Strategic [15s]: strategic pacing, every death matters (15-30s wait), defenders mass into large coordinated waves before committing. | Tactical [30s]: heavy combat simulation, every death is critical (30-60s wait), teams respawn in full battalions for macro maps with heavy vehicles. | Solo games use the same length as a plain wait."
CyclePresetText="3.000000;Arena [3s];5.000000;Standard [5s];10.000000;Methodic [10s];15.000000;Strategic [15s];30.000000;Tactical [30s]"

[RespawnDelay.RespawnDelayCountdown]
Label="Respawn in "
FinalLabel="Respawn!"
