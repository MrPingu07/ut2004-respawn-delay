[Public]
Object=(Name=RespawnDelay.RespawnDelay,Class=Class,MetaClass=Engine.Mutator,Description="Respawn Delay,Players must wait before respawning. Team games: global configurable wave cycle (Standard [5-10s], presets from Arena [3-6s] to Tactical [30-60s] in the Mutator GUI). Solo games: the selected cycle length as a plain wait (3s, 5s, 10s, 15s or 30s). While waiting you spectate (FIRE cycles views).")
Mutator=(ClassName=RespawnDelay.RespawnDelay,IconMaterialName=MutatorArt.nosym,FriendlyName=RespawnDelay.RespawnDelay.FriendlyName,Description=RespawnDelay.RespawnDelay.Description,FallbackName="Respawn Delay",FallbackDesc="Forces players to wait before respawning. Team games respawn together in waves on a global configurable cycle (Standard [5-10s], presets from Arena [3-6s] to Tactical [30-60s]); solo games use the selected cycle length as a plain wait (3s, 5s, 10s, 15s or 30s). While waiting you are a spectator (FIRE to cycle views).")

[RespawnDelay.RespawnDelay]
FriendlyName="Respawn Delay"
Description="Forces players to wait before respawning. Team games respawn together in waves on a global configurable cycle: waits always span one to two cycles (presets selectable in the Mutator GUI: Arena [3-6s], Standard [5-10s], Methodic [10-20s], Strategic [15-30s], Tactical [30-60s]). Solo games use the selected cycle length as a plain wait (3s, 5s, 10s, 15s or 30s). While waiting you are a spectator (FIRE to cycle views)."

; -- localized strings used by the mutator (via ClientMessage) --
MsgRespawnTeam="Spawn with the next reinforcement wave in %1 seconds"
MsgRespawnSolo="Respawn delay locked at %1 seconds"
MsgSpectateHint="Waiting to respawn - FIRE: next player view, ALT-FIRE: own camera"
MsgStatusWaiting="RespawnDelay: you respawn in %1 seconds"
MsgStatusIdle="RespawnDelay: not waiting to respawn."

; -- mutator GUI (PlayInfo / "Configure" pages) --
RespGroup="Respawn Delay"
CycleDisplayText="Respawn wave cycle"
CycleDescText="Arena [3-6s]: continuous chaos, near-instant respawns and fast micro-batches, great for Team Deathmatch and small maps. | Standard [5-10s]: competitive balance, the perfect equilibrium, tailored for tactical flow and squad spawning in Onslaught and Assault. | Methodic [10-20s]: methodical pacing, moderate punishment for dying, teams regroup into waves before pushing. | Strategic [15-30s]: strategic pacing, every death matters, defenders mass into large coordinated waves before committing. | Tactical [30-60s]: heavy combat simulation, every death is critical, teams respawn in full battalions for macro maps with heavy vehicles. | Team-game waits always span one to two cycles; solo games wait exactly the selected cycle length (3s, 5s, 10s, 15s or 30s)."
CyclePresetText="3.000000;Arena [3-6s];5.000000;Standard [5-10s];10.000000;Methodic [10-20s];15.000000;Strategic [15-30s];30.000000;Tactical [30-60s]"

[RespawnDelay.RespawnDelayCountdown]
Label="Respawn in "
FinalLabel="Respawn!"
